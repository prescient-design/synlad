     # # 5. Create the data
     # ## a. preprocess function
+    # ### check the direction is valid (at moment we cannot evaluate in mix mode, but this may change in the future)
+    direction = train_submethods.TaskDirection(eval_args.direction)
+    if direction not in {train_submethods.TaskDirection.FORWARDS, train_submethods.TaskDirection.BACKWARDS}:
+        raise NotImplementedError(f"Direction {direction} not implemented for evaluation.")
+
+    # ### work out how the model was trained (from its checkpoint) and calculate the prefix
