diff --git a/scripts/serving/serve.py b/scripts/serving/serve.py
new file mode 100644
index 0000000..66972a3
--- /dev/null
+++ b/scripts/serving/serve.py
@@ -0,0 +1,97 @@
+"""
+Start using :
+`WEIGHTS_PATH=<path to model weights> serve run serve:main_deployment `
+"""
+
+
+import argparse
+import itertools
+import os
+from typing import List
+
+from fastapi import FastAPI
+import ray
+from ray import serve
+
+from rxn_lm.server_utils import pipeline, api_types
+
+
+app = FastAPI(title="rxn-lm", summary="Predict reactions from SMILES strings!")
+
+
+def batched(iterable, n, strict=False):
+    """
+    Batches an iterable into chunks of size n.
+    If strict is True, will raise an error if the batch size is less than n. Pre Python 3.12 version of itertools.batched.
+    """
+    if n < 1:
+        raise ValueError('n must be at least one')
+    it = iter(iterable)
+    while True:
+        batch = tuple(itertools.islice(it, n))
+        if not batch:
+            break
+        elif len(batch) < n and strict:
+            raise ValueError(f"Batch size {len(batch)} is less than {n}")
+        yield batch
+
+
+@serve.deployment(num_replicas=1, ray_actor_options={"num_gpus": 1})
+class ModelPipeline:
+    def __init__(self, model_path: str):
+        self.num_return_sequences = 5
+        self.batch_size = 32
+        # ^ currently hardcoded but possible to change in future
+        self.pipe = pipeline.create_reaction_pipeline(model_path, num_return_sequences=self.num_return_sequences)
+
+    def run_pipeline(self, inputs: List[api_types.PredictInput]) -> List[api_types.PredictOutput]:
+        pipeline_inputs = [input.to_pipeline_input() for input in inputs]
+        pipe_outputs = pipeline.run_pipeline(self.pipe, pipeline_inputs, batch_size=self.batch_size)
+
+        outputs = []
+
+        # putting in strict mode as model should return num_return_sequences per input. if it doesn't,
+        # then we have a problem as cannot match up outputs with inputs.. so will just fail loudly.
+        for i, result in enumerate(batched(pipe_outputs, self.num_return_sequences, strict=True)):
+            outputs.append(api_types.PredictOutput(
+                smiles=inputs[i].smiles,
+                direction=inputs[i].direction,
+                predictions=[
+                    api_types.IndividualPrediction(
+                        smiles=res["generated_text"],
+                        score=res["generated_sequence_score"]
+                    )
+                    for res in result
+                ]
+            ))
+
+        return outputs
+
+
+@serve.deployment(route_prefix="/")
+@serve.ingress(app)
+class MainDeployment:
+    def __init__(self, model: ModelPipeline):
+        self.model = model
+
+    @app.post("/predict")
+    async def root(self, request: api_types.PredictRequest) -> api_types.PredictResponse:
+        model_serve_response = await self.model.run_pipeline.remote(request.inputs)
+        list_of_outputs = await model_serve_response
+
+        # note the two awaits are on purpose! better than using .get() as that will block
+        # https://docs.ray.io/en/releases-2.2.0/serve/model_composition.html#:~:text=You%20can%20use,get%20inside%20deployments.
+
+        return api_types.PredictResponse(outputs=list_of_outputs)
+
+
+# parser = argparse.ArgumentParser()
+# parser.add_argument("--model_path", type=str, required=True)
+# parser.add_argument("--port", type=int, default=8050)
+# args = parser.parse_args()
+# serve.run(MainDeployment.bind(ModelPipeline.bind(args.model_path)), port=args.port)
+
+weights_path = os.environ["WEIGHTS_PATH"]
+print(f"Using weights from {weights_path}")
+main_deployment = MainDeployment.bind(ModelPipeline.bind(weights_path))
+
