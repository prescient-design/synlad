+from dataclasses import dataclass
+import os.path as osp
+from pathlib import Path
+from typing import Union, List, Dict, Any, Tuple, Optional
+
+import numpy as np
+import torch
+from transformers import BartForConditionalGeneration, Pipeline, pipeline, Text2TextGenerationPipeline
+from transformers.pipelines.text2text_generation import ReturnType
+
+from ..tokenizer import ReactionBartTokenizer, FWD_TOKEN, REV_TOKEN
+from ..train_utils import train_submethods
+
+
+
+
+
+
+class ReactionPipeline(Text2TextGenerationPipeline):
+    """Overwriting the default Text2TextGenerationPipeline to also return scores (i.e., "log probability of sequence").
+
+    Note what actually is a "score" in Hugging Face is not actually immediately always clear. See
+    https://discuss.huggingface.co/t/announcement-generation-get-probabilities-for-generated-output/30075
+
+    Scores are described as "log probabilities" but might not be normalized (due to the logit processing --
+    which as far as I understand actually is done on the log probabilities rather than the logits...).
+    """
+    def _forward(self, model_inputs, **generate_kwargs):
+        if self.framework == "pt":
+            input_length = model_inputs["input_ids"].shape[-1]
+        elif self.framework == "tf":
+            raise NotImplementedError("TF not supported")
+
+        generate_kwargs["min_length"] = generate_kwargs.get("min_length", self.model.config.min_length)
+        generate_kwargs["max_length"] = generate_kwargs.get("max_length", self.model.config.max_length)
+        generate_kwargs["output_scores"] = True
+        generate_kwargs["return_dict_in_generate"] = True
+        self.check_inputs(input_length, generate_kwargs["min_length"], generate_kwargs["max_length"])
+        out = self.model.generate(**model_inputs, **generate_kwargs)
+        return {"output_ids": out["sequences"], "sequences_scores": out["sequences_scores"]}
+
+    def postprocess(self, model_outputs, return_type=ReturnType.TEXT, clean_up_tokenization_spaces=False):
+        records = []
+        for output_ids, seq_score in zip(model_outputs["output_ids"], model_outputs["sequences_scores"]):
+            if return_type == ReturnType.TENSORS:
+                record = {f"{self.return_name}_token_ids": model_outputs, f"{self.return_name}_sequence_score": seq_score}
+            elif return_type == ReturnType.TEXT:
+                record = {
+                    f"{self.return_name}_text": self.tokenizer.decode(
+                        output_ids,
+                        skip_special_tokens=True,
+                        clean_up_tokenization_spaces=clean_up_tokenization_spaces,
+                    ),
+                    f"{self.return_name}_sequence_score": float(seq_score.item())
+                }
+            records.append(record)
+        return records
+
+
+def create_reaction_pipeline(
+    checkpoint_path: Union[str, Path],
+    device: Union[int, None] = None,
+    num_return_sequences: int = 5,
+    num_beams: int = 5,
+    max_length: int = 1024,
+    **kwargs
+) -> Pipeline:
+    """
+    Create a Hugging Face pipeline for reaction prediction using a specific checkpoint.
+
+    Args:
+        checkpoint_path: Path to the model checkpoint directory
+        device: Device to run the model on:
+            - None: Will use CUDA if available, otherwise CPU
+            - -1: CPU
+            - 0 or higher: GPU index
+        num_return_sequences: Number of sequences to return (default: 5)
+        num_beams: Number of beams for beam search (default: 5)
+        max_length: Maximum length of generated sequences (default: 1024)
+        **kwargs: Additional arguments to pass to the pipeline
+
+    Returns:
+        A Hugging Face pipeline configured for reaction prediction
+    """
+    if device is None:
+        device = 0 if torch.cuda.is_available() else -1
+
+    # Create model and tokenizer from checkpoint
+    model = BartForConditionalGeneration.from_pretrained(checkpoint_path)
+    tokenizer = ReactionBartTokenizer.from_pretrained(checkpoint_path)
+
+    # Verify model and tokenizer are consistent
+    assert model.get_input_embeddings().weight.shape[0] == len(tokenizer), "Model and tokenizer inconsistent"
+
+    # Set model to evaluation mode to disable dropout and other training-specific behaviors
+    model.eval()
+
+    # Work out direction model was trained for.
+    training_data_args = torch.load(osp.join(checkpoint_path, "data_args.pt"), map_location=device)
+    training_direction = train_submethods.TaskDirection(training_data_args.direction)
+
+    # Create pipeline with beam search
+    pipe = ReactionPipeline(
+        model=model,
+        tokenizer=tokenizer,
+        device=device,
+        num_return_sequences=num_return_sequences,
+        num_beams=num_beams,
+        max_length=max_length,
+        **kwargs
+    )
+
+    # we will also store the direction
+    pipe.direction_used_in_training = training_direction
+
+    return pipe
+
+
+@dataclass
+class PredInput:
+    smiles: str
+    direction: Union[str, train_submethods.TaskDirection]
+
+    def __post_init__(self):
+        if isinstance(self.direction, str):
+            self.direction = train_submethods.TaskDirection(self.direction)
+
+
+def run_pipeline(
+    pipe,
+    inputs: List[PredInput],
+    batch_size: int = 32,
+    **kwargs
+) -> List[Dict[str, Any]]:
+    """
+    Run the pipeline on a batch of inputs.
+
+    Args:
+        pipe: Hugging Face pipeline to use
+        inputs: List of input dictionaries, each containing the text to process
+        batch_size: Maximum number of inputs to process at once (default: 32)
+        **kwargs: Additional arguments to pass to the pipeline's __call__ method
+
+    Returns:
+        List of output dictionaries containing the generated sequences
+    """
+    #TODO: maybe want to move some of this logic to the subclass of pipeline?
+    if pipe.direction_used_in_training == train_submethods.TaskDirection.MIX:
+        def process_input(input: PredInput) -> str:
+            if input.direction == train_submethods.TaskDirection.FORWARDS:
+                return f"{FWD_TOKEN}{input.smiles}"
+            elif input.direction == train_submethods.TaskDirection.BACKWARDS:
+                return f"{REV_TOKEN}{input.smiles}"
+            else:
+                raise ValueError(f"Invalid direction: {input.direction}")
+    else:
+        def process_input(input: PredInput) -> str:
+            assert input.direction == pipe.direction_used_in_training, "inconsistent direction"
+            return input.smiles
+
+    # Convert to a list of strings (checking direction is valid for each)
+    processed_inputs = []
+    for input in inputs:
+        processed_inputs.append(process_input(input))
+
+    out = pipe(processed_inputs, batch_size=batch_size, **kwargs)
+
+    return out
+
+
