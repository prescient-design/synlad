# Copy this file to `.env` and adjust the paths to match your environment.
# These variables are read by configs/paths/default.yaml via `${oc.env:VAR,fallback}`,
# so anything you do not set will fall back to a path under the project root.

# Where datasets live (pathway pickles, vocab JSONs, ligand .pkls, etc.).
DATA_DIR=

# Where Hydra writes run outputs (logs, hydra config snapshots, etc.).
OUTPUT_DIR=

# Where model checkpoints are written. Each run gets its own timestamped
# sub-directory ($CHECKPOINTS_DIR/${name}_${now:...}) so concurrent jobs
# don't overwrite each other.
CHECKPOINTS_DIR=

# Where evaluation visualisations are written.
VIZ_DIR=

# Wandb entity
WANDB_ENTITY=

# Directory to log outputs
LOG_DIR=
